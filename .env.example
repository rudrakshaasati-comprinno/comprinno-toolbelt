# ── Kiro ─────────────────────────────────────────────────────────────────────
# Get your API key from https://app.kiro.dev (Account > API Keys)
KIRO_API_KEY=ksk_your_key_here

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1

# IAM user credentials that have S3 read/write access to the bucket below
# and sts:AssumeRole permission (for scoped agent credentials)
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# Leave empty unless using temporary credentials (e.g. assumed role)
AWS_SESSION_TOKEN=

# ── S3 ────────────────────────────────────────────────────────────────────────
# The name of the S3 bucket you created (e.g. comprinno-presales)
S3_BUCKET=your-bucket-name-here

# ── Postgres ──────────────────────────────────────────────────────────────────
PGUSER=presales
PGPASSWORD=change_me_strong_password
PGDATABASE=presales
